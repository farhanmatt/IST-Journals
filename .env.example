# Database
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Gmail SMTP Credentials for User Password Notification
# Steps to obtain:
# 1. Enable 2-Step Verification in Google Account (https://myaccount.google.com/security)
# 2. Go to App Passwords (https://myaccount.google.com/apppasswords)
# 3. Create an app named "OJS / IST Journals" and copy the 16-character password
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
